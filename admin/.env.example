# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/facebookmanagement?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facebookmanagement?schema=public"

# Used to sign admin sessions (JWT). Use a long random string.
AUTH_SECRET="change-me-to-a-long-random-string"

# Public app URL (used for redirects)
APP_URL="http://localhost:3000"

# Facebook App (for future: connect pages)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/facebook/callback"
